---
import BaseLayout from '../layouts/BaseLayout.astro';
import MilledButton from '../components/MilledButton.astro';
import OutlineButton from '../components/OutlineButton.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BentoCard from '../components/BentoCard.astro';
import GlassCard from '../components/GlassCard.astro';
import { PACKS, isIncludedPackFeature } from '../data/packs';

const visibilitePack = PACKS.find((p) => p.id === 'visibilite')!;

const timeline = [
	{
		step: 1,
		label: 'Stratégie',
		desc: 'Nous analysons votre marché, vos concurrents, et vos objectifs pour définir la meilleure approche.',
		active: false,
	},
	{
		step: 2,
		label: 'Design',
		desc: 'Maquette sur-mesure validée par vous avant toute ligne de code.',
		active: false,
	},
	{
		step: 3,
		label: 'Développement',
		desc: 'Code performant, SEO intégré, tests sur tous les appareils.',
		active: false,
	},
	{
		step: 4,
		label: 'Lancement',
		desc: 'Mise en ligne, configuration DNS, soumission Google — votre site est live.',
		active: true,
	},
];

const ctaStats = [
	{ count: 100, suffix: '%', label: 'Uptime' },
	{ count: 24, suffix: '/7', label: 'Disponibilité' },
	{ text: 'SEO', label: 'Intégré' },
	{ count: 14, suffix: 'j*', label: 'Livraison' },
];
---

<BaseLayout
	title="Création de Site Web à Casablanca — Infrastructure Cloudflare | ATLASEO"
	description="Sites web ultra-rapides sur Cloudflare. Design responsive, Lighthouse 99/100, livraison en 14 jours. L'infrastructure premium pour votre entreprise au Maroc."
	preloadHero="/images/hero-creation-web.webp"
>
	<!-- 3.1 Hero -->
	<section data-animate class="bg-surface-container-low py-xl">
		<div class="container-site grid grid-cols-1 items-center gap-xl lg:grid-cols-2">
			<div class="flex min-w-0 flex-1 flex-col gap-md">
				<span class="label-caps text-secondary">Création Web</span>
				<h1 class="text-display-hero font-display text-on-surface">
					Créez un site web qui propulse votre activité.
				</h1>
				<p class="w-full text-body-lg text-on-surface-variant">
					Infrastructure Cloudflare, design sur-mesure, performance maximale. Votre site professionnel
					livré en 14 jours*, prêt à convertir.
				</p>
				<p class="text-sm text-on-surface-variant">
					* Le délai commence à la réception de tous les éléments nécessaires.
				</p>
				<MilledButton href="/contact" text="Lancer mon projet" class="w-full justify-center sm:w-auto" />
			</div>
			<div class="relative">
				<div
					class="card-elevated overflow-hidden rounded-2xl border border-outline-variant/30"
				>
					<img
						src="/images/hero-creation-web.webp"
						alt="Création de site web professionnel sur mesure — ATLASEO agence web Casablanca"
						width="800"
						height="500"
						class="w-full"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<GlassCard
					padding="sm"
					class="absolute -bottom-4 -left-4 flex items-center gap-2 max-sm:relative max-sm:mt-md max-sm:w-fit"
				>
					<span class="icon-scale-wrap">
						<span class="material-symbols-outlined text-secondary">speed</span>
					</span>
					<span class="font-display text-xl font-bold" data-count="99" data-count-suffix="/100">0/100</span>
				</GlassCard>
			</div>
		</div>
	</section>

	<!-- 3.2 Bento -->
	<section data-animate class="py-xl">
		<div class="container-site flex flex-col gap-xl">
			<SectionHeader
				title="L'infrastructure de demain pour votre entreprise"
				subtitle="Chaque site que nous créons repose sur les mêmes technologies que les leaders mondiaux du web."
			/>
			<div class="grid grid-cols-1 gap-md md:grid-cols-3" data-animate-stagger>
				<BentoCard span={2} icon="cloud_done" title="Hébergement Cloudflare Enterprise">
					<p>
						Réseau de 300+ data centers dans le monde. Temps de réponse &lt;50ms depuis le Maroc.
						CDN, cache intelligent, et protection DDoS inclus.
					</p>
				</BentoCard>
				<BentoCard icon="devices" title="Responsive Design">
					<p>
						Chaque pixel est pensé pour mobile, tablette et desktop. 60% de vos visiteurs viendront
						du mobile.
					</p>
				</BentoCard>
				<BentoCard icon="palette" title="Design Sur-mesure">
					<p>
						Pas de templates génériques. Votre identité visuelle traduite en un design unique et
						professionnel.
					</p>
				</BentoCard>
				<BentoCard span={2} dark icon="hub" title="Intégration Business" class="relative overflow-hidden">
					<span
						class="material-symbols-outlined pointer-events-none absolute -right-4 -top-4 text-[120px] opacity-20"
						aria-hidden="true"
					>
						hub
					</span>
					<p class="relative z-10">
						WhatsApp, Google Analytics, Search Console, formulaires — tout est connecté dès le
						lancement.
					</p>
				</BentoCard>
				<article
					data-animate
					class="group relative aspect-[8/5] overflow-hidden rounded-xl border border-outline-variant/30 transition-all duration-200 ease-out hover:border-primary md:col-span-3"
				>
					<img
						src="/images/dev-setup.webp"
						alt="Environnement de développement web professionnel — création site vitrine performant ATLASEO Casablanca"
						width="800"
						height="500"
						class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0"
						loading="lazy"
					/>
					<div
						class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-primary-container/90 to-transparent p-lg"
					>
						<h3 class="font-display text-headline-md-mobile font-semibold text-on-primary md:text-headline-md">
							Expertise Technique Premium
						</h3>
						<p class="mt-2 text-body-md text-on-primary/80">
							Code propre, performance maximale et standards internationaux pour chaque projet web.
						</p>
					</div>
				</article>
			</div>
		</div>
	</section>

	<!-- 3.3 Timeline -->
	<section data-animate class="bg-surface-container-low py-xl">
		<div class="container-site flex flex-col gap-xl">
			<SectionHeader
				title="Votre site prêt en 14 jours*"
				subtitle="Un processus clair, sans surprises."
			/>
			<p class="text-sm text-on-surface-variant">
				* Le délai commence à la réception de tous les éléments nécessaires.
			</p>
			<ol class="grid grid-cols-1 gap-lg md:grid-cols-4" data-animate-stagger>
				{
					timeline.map((item, index) => (
						<li data-animate class="relative flex flex-col gap-md">
							{index < timeline.length - 1 && (
								<div
									class="absolute left-5 top-12 hidden h-px w-full bg-outline-variant md:block"
									aria-hidden="true"
								/>
							)}
							<div
								class:list={[
									'flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-display text-sm font-bold',
									item.active
										? 'bg-secondary text-on-secondary'
										: 'bg-primary text-on-primary',
								]}
							>
								{item.step}
							</div>
							<div>
								<h3 class="font-display text-lg font-semibold text-on-surface">{item.label}</h3>
								<p class="mt-2 text-body-md text-on-surface-variant">{item.desc}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- 3.4 CTA Block -->
	<section data-animate class="py-xl">
		<div class="container-site">
			<div
				data-animate
				class="grid grid-cols-1 items-center gap-xl rounded-2xl bg-primary p-md text-on-primary transition-all duration-200 ease-out sm:p-xl lg:grid-cols-2"
			>
				<div class="flex flex-col gap-md">
					<h2 class="text-balance font-display text-headline-lg-mobile font-semibold md:text-headline-lg">
						Prêt à transformer votre présence digitale ?
					</h2>
					<p class="text-body-lg text-on-primary/80">
						Rejoignez les entreprises marocaines qui ont choisi l'infrastructure premium.
					</p>
					<div class="flex w-full flex-col gap-md sm:flex-row sm:flex-wrap">
						<MilledButton href="/contact" text="Démarrer mon projet" class="w-full justify-center sm:w-auto" />
						<OutlineButton href="/offres" text="Voir nos offres" variant="light" class="w-full justify-center sm:w-auto" />
					</div>
				</div>
				<div class="grid grid-cols-2 gap-md" data-animate-stagger>
					{
						ctaStats.map((stat) => (
							<div
								data-animate
								class="rounded-xl border border-white/20 bg-white/5 p-md text-center transition-all duration-200 ease-out hover:border-white/40"
							>
								<p class="font-display text-3xl font-bold text-secondary-container">
									{'count' in stat ? (
										<span
											data-count={stat.count}
											data-count-suffix={stat.suffix}
										>
											0{stat.suffix}
										</span>
									) : (
										stat.text
									)}
								</p>
								<p class="label-caps mt-2 text-on-primary/70">{stat.label}</p>
							</div>
						))
					}
				</div>
			</div>
			<p class="mt-sm text-center text-sm text-on-surface-variant">
				* Le délai commence à la réception de tous les éléments nécessaires.
			</p>
		</div>
	</section>

	<!-- 3.5 Pack Visibilité -->
	<section data-animate class="py-xl">
		<div class="container-site flex flex-col gap-xl">
			<div class="flex flex-col items-center gap-md text-center">
				<span class="label-caps rounded-full bg-secondary-container px-4 py-2 text-secondary-on-container">
					Pack Visibilité
				</span>
				<h2 class="font-display text-headline-lg-mobile font-semibold md:text-headline-lg">
					Le Pack Visibilité
				</h2>
				<p class="max-w-2xl text-body-lg text-on-surface-variant">
					Le pack recommandé pour lancer votre présence en ligne avec un site performant et une
					visibilité locale dès le premier jour.
				</p>
			</div>
			<GlassCard class="grid grid-cols-1 gap-xl lg:grid-cols-2 lg:items-center">
				<ul class="flex flex-col gap-sm">
					{
						visibilitePack.features.map((feature) => (
							<li
								class:list={[
									'flex items-start gap-2 text-body-md text-on-surface-variant',
									isIncludedPackFeature(feature) &&
										'-mx-2 rounded-r border-l-2 border-secondary bg-secondary/5 px-2 py-1.5 font-semibold text-on-surface',
								]}
							>
								<span class="icon-scale-wrap">
									<span class="material-symbols-outlined text-secondary">check_circle</span>
								</span>
								{feature}
							</li>
						))
					}
				</ul>
				<div class="flex flex-col items-center gap-md lg:items-end">
					<p class="text-center text-body-md text-on-surface-variant lg:text-right">
						Consultez nos{' '}
						<a href="/offres" class="text-secondary hover:underline">
							offres de création de site web au Maroc
						</a>{' '}
						pour comparer les packs Starter, Visibilité et Croissance.
					</p>
					<MilledButton href="/contact" text="Choisir Visibilité" size="lg" class="w-full justify-center sm:w-auto" />
				</div>
			</GlassCard>
		</div>
	</section>
</BaseLayout>
