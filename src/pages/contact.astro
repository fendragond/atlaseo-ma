---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
import { SITE } from '../data/site';

const approachCards = [
	{
		icon: 'route',
		title: 'Parcours utilisateur',
		copy: "Avant de coder une ligne, nous cartographions le parcours de vos visiteurs : ce qu'ils cherchent, ce qui les fait douter, ce qui les fait agir. Le design suit la conversion, pas l'inverse.",
	},
	{
		icon: 'ads_click',
		title: 'Stratégie de conversion',
		copy: "Chaque page a un objectif : faire passer le visiteur à l'action. Hiérarchie de l'information, placement des CTAs, gestion des objections — chaque détail est pensé pour transformer la visite en contact.",
	},
	{
		icon: 'palette',
		title: 'Discipline UX/UI',
		copy: 'Hiérarchie visuelle, lisibilité mobile, accessibilité, vitesse perçue. Les détails qui font la différence entre un site "joli" et un site qui convertit réellement.',
	},
];

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://atlaseo.ma/' },
		{ '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://atlaseo.ma/contact' },
	],
};
---

<BaseLayout
	title="Contact — Devis SEO Gratuit | ATLASEO Casablanca"
	description="Contactez ATLASEO — devis personnalisé gratuit sous 24h ouvrées. WhatsApp disponible pour une réponse instantanée. 📞 +212 6XX XX XX XX"
	breadcrumbSchema={breadcrumbSchema}
	hideWhatsAppFab
>
	<!-- 5.1 Hero -->
	<section data-animate class="py-xl">
		<div class="container-site flex max-w-3xl flex-col gap-md">
			<p class="label-caps text-secondary">Contact & Support</p>
			<h1 class="text-display-hero font-display text-on-surface">
				Parlons de votre{' '}
				<span class="hero-gradient-text">croissance</span>
			</h1>
			<p class="text-body-lg text-on-surface-variant">
				Que vous soyez une PME ou un commerçant local au Maroc, notre équipe est prête à booster votre
				visibilité sur Google.
			</p>
		</div>
	</section>

	<!-- 5.1.5 About ATLASEO -->
	<section data-animate class="bg-surface-container-low py-xl">
		<div class="container-site flex flex-col gap-lg">
			<div class="flex flex-col items-center gap-md text-center">
				<img
					src="/images/logos/atlaseo-logo-stacked.png"
					alt="ATLASEO"
					width="192"
					height="96"
					class="h-56 w-auto"
					loading="lazy"
				/>
				<p class="font-display text-headline-md italic text-on-surface-variant">
					Pensé local. Indexé global.
				</p>
			</div>

			<div class="grid grid-cols-1 gap-lg lg:grid-cols-12 lg:items-stretch">
				<div class="flex flex-col justify-center gap-md lg:col-span-7">
					<h2 class="font-display text-headline-lg-mobile text-on-surface md:text-headline-lg">
						Qui sommes-nous ?
					</h2>
					<p class="text-body-lg text-on-surface-variant">
						ATLASEO est une agence web indépendante basée à Casablanca. Nous concevons des sites premium
						sur infrastructure Cloudflare et pilotons leur référencement sur Google et les moteurs de
						recherche IA (ChatGPT, Perplexity, Gemini).
					</p>
					<p class="text-body-lg text-on-surface-variant">
						Notre positionnement comble un vide du marché marocain : entre les sites low-cost qui
						n'apportent aucun client et les agences corporate inaccessibles, nous proposons un standard
						premium pour les entreprises qui veulent une présence digitale à la hauteur de leurs ambitions.
					</p>
				</div>

				<GlassCard
					class="relative flex h-full flex-col items-center justify-center gap-sm overflow-hidden text-center lg:col-span-5"
					padding="lg"
				>
					<span
						class="material-symbols-outlined absolute left-6 top-6 text-5xl text-secondary/15"
						aria-hidden="true"
					>
						format_quote
					</span>
					<img
						src="/images/team/fondateur.webp"
						alt="Fahd D., fondateur d'ATLASEO"
						width="96"
						height="96"
						class="h-24 w-24 rounded-full border-2 border-secondary/20 object-cover"
						loading="lazy"
					/>
					<p class="label-caps text-secondary">Fondateur</p>
					<h3 class="font-display text-headline-md text-on-surface">Fahd D.</h3>
					<p class="text-body-md italic text-on-surface-variant">
						Nous avons créé ATLASEO parce qu'au Maroc, trop d'entreprises payaient cher pour des sites
						invisibles sur Google. Notre engagement : un interlocuteur unique, un site livré en 14 jours,
						et une visibilité que vous pouvez mesurer.
					</p>
				</GlassCard>
			</div>

			<div class="border-t border-outline-variant/30 pt-lg">
				<div class="mx-auto flex max-w-3xl flex-col items-center gap-sm text-center">
					<p class="label-caps text-secondary">Notre approche</p>
					<h2 class="font-display text-headline-lg-mobile text-on-surface md:text-headline-lg">
						Une approche produit, pas une livraison de plaquette.
					</h2>
					<p class="max-w-2xl text-body-lg text-on-surface-variant">
						Notre méthodologie est issue du monde du Product Management — la même discipline qui guide
						les meilleurs produits digitaux.
					</p>
				</div>

				<div class="mt-lg grid grid-cols-1 gap-md lg:grid-cols-3" data-animate-stagger>
					{
						approachCards.map((card) => (
							<article data-animate class="card-default flex h-full flex-col gap-md p-lg">
								<span class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container text-secondary-on-container">
									<span class="material-symbols-outlined text-3xl" aria-hidden="true">
										{card.icon}
									</span>
								</span>
								<h3 class="font-display text-headline-md text-on-surface">{card.title}</h3>
								<p class="text-body-md text-on-surface-variant">{card.copy}</p>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- 5.2 Location -->
	<section data-animate class="bg-surface-container-low py-xl">
		<div class="container-site grid grid-cols-1 gap-xl lg:grid-cols-2">
			<div class="relative overflow-hidden rounded-2xl">
				<img
					src="/images/casablanca-aerial.webp"
					alt="Vue aérienne de Casablanca au crépuscule — ATLASEO agence SEO local et création site web Maroc"
					width="800"
					height="500"
					class="min-h-[200px] w-full object-cover sm:min-h-[280px]"
					loading="lazy"
				/>
				<span
					class="glass-card label-caps absolute bottom-4 left-4 rounded px-4 py-2 text-on-surface"
				>
					Siège social — Casablanca, Maroc
				</span>
			</div>
			<div class="flex flex-col justify-center gap-md">
				<h3 class="font-display text-headline-md font-semibold text-on-surface">
					Expertise de proximité
				</h3>
				<p class="text-body-md text-on-surface-variant">
					Nous comprenons les spécificités du marché marocain. Notre accompagnement en SEO local est
					conçu pour connecter votre activité avec ses clients idéaux, à Casablanca, Marrakech, Rabat
					et partout au Maroc.
				</p>
			</div>
		</div>
	</section>

	<!-- 5.3 Contact Channels -->
	<section data-animate class="py-xl">
		<div class="container-site flex flex-col gap-md" data-animate-stagger>
			<!-- WhatsApp -->
			<article
				data-animate
				class="flex flex-col items-start gap-md rounded-2xl border border-secondary/30 bg-secondary-container p-lg transition-colors duration-200 ease-out hover:border-primary"
			>
				<div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container">
					<span class="material-symbols-outlined text-3xl text-secondary" aria-hidden="true">
						chat
					</span>
				</div>
				<h2 class="font-display text-headline-md font-semibold text-on-surface">
					Contactez-nous sur WhatsApp
				</h2>
				<p class="text-body-md text-on-surface-variant">
					Pour une réponse instantanée, c'est le moyen le plus rapide de nous joindre.
				</p>
				<a
					href={SITE.whatsapp}
					target="_blank"
					rel="noopener noreferrer"
					class="milled-button mt-auto w-full justify-center py-4"
				>
					Démarrer une conversation WhatsApp
				</a>
			</article>

			<div class="grid grid-cols-1 items-start gap-md lg:grid-cols-3">
				<!-- Email -->
				<article
					data-animate
					class="flex flex-col items-start gap-md rounded-2xl border border-outline-variant/30 bg-white p-lg transition-colors duration-200 ease-out hover:border-primary"
				>
					<div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container">
						<span class="material-symbols-outlined text-3xl text-secondary" aria-hidden="true">
							mail
						</span>
					</div>
					<h3 class="font-display text-xl font-semibold text-on-surface">Envoyez-nous un email</h3>
					<p class="text-body-md text-on-surface-variant">
						Pour les demandes détaillées ou les documents à partager.
					</p>
					<a
						href={`mailto:${SITE.email}`}
						class="mt-auto inline-flex min-h-11 items-center text-body-lg font-medium text-secondary hover:underline"
					>
						{SITE.email}
					</a>
				</article>

				<!-- Phone -->
				<article
					data-animate
					class="flex flex-col items-start gap-md rounded-2xl border border-outline-variant/30 bg-white p-lg transition-colors duration-200 ease-out hover:border-primary"
				>
					<div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container">
						<span class="material-symbols-outlined text-3xl text-secondary" aria-hidden="true">
							call
						</span>
					</div>
					<h3 class="font-display text-xl font-semibold text-on-surface">Appelez-nous</h3>
					<p class="text-body-md text-on-surface-variant">
						Disponible du lundi au vendredi, 9h-18h.
					</p>
					<a
						href={`tel:${SITE.phoneTel}`}
						class="mt-auto inline-flex min-h-11 items-center text-body-lg font-medium text-secondary hover:underline"
					>
						{SITE.phone}
					</a>
				</article>

				<!-- Support -->
				<article
					data-animate
					class="flex flex-col items-start gap-md rounded-2xl border border-outline-variant/30 bg-white p-lg transition-colors duration-200 ease-out hover:border-primary"
				>
					<div class="flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container">
						<span class="material-symbols-outlined text-3xl text-secondary" aria-hidden="true">
							support_agent
						</span>
					</div>
					<h4 class="font-display text-lg font-semibold text-on-surface">Support client</h4>
					<a
						href={`mailto:${SITE.email}`}
						class="inline-flex min-h-11 items-center text-body-md text-secondary hover:underline"
					>
						{SITE.email}
					</a>
					<p class="text-body-md text-on-surface-variant">
						Réponse prioritaire en moins de 2h pour les clients Pack Croissance.
					</p>
				</article>
			</div>
		</div>
	</section>

</BaseLayout>
