---
import BaseLayout from '../layouts/BaseLayout.astro';
import MilledButton from '../components/MilledButton.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BentoCard from '../components/BentoCard.astro';
import CtaBanner from '../components/CtaBanner.astro';

const epicenterCards = [
	{
		icon: 'visibility',
		titleCount: 80,
		titleSuffix: ' de Visibilité',
		copy: '4 consommateurs sur 5 utilisent Google pour trouver un professionnel près de chez eux. Sans fiche optimisée, vous êtes invisible.',
	},
	{
		icon: 'reviews',
		title: 'Preuve Sociale',
		copy: 'Les avis Google sont le premier critère de confiance. Une note au-dessus de 4.5 augmente les conversions de 25%.',
	},
	{
		icon: 'trending_up',
		title: 'ROI Accéléré',
		copy: 'Le SEO local génère des leads qualifiés à un coût 3x inférieur à la publicité payante. Résultats durables, pas éphémères.',
	},
] as const;

const methodology = [
	{
		num: '01',
		title: 'Ciblage de Mots-clés Géo',
		desc: 'Analyse des requêtes locales dans votre secteur. Identification des opportunités de positionnement à Casablanca, Rabat, Marrakech et au-delà.',
	},
	{
		num: '02',
		title: 'Optimisation du Profil',
		desc: 'Configuration complète de votre Google Business Profile : catégories, horaires, photos, services, attributs — chaque détail compte.',
	},
	{
		num: '03',
		title: 'Citations Locales & NAP',
		desc: 'Cohérence parfaite de votre Nom, Adresse et Téléphone sur tous les annuaires et plateformes pertinents au Maroc.',
	},
	{
		num: '04',
		title: "Stratégie d'Avis Clients",
		desc: 'Mise en place d\'un processus pour collecter des avis authentiques et y répondre professionnellement.',
	},
];

const infraChecks = [
	'Cloudflare Workers',
	'SSL + DDoS',
	'CDN 300+ villes',
];

const localSeoErrors = [
	{
		title: 'Une fiche Google Business incomplète',
		copy: "C'est l'erreur la plus répandue au Maroc. Des milliers de professionnels ont créé leur fiche Google sans remplir les services, les horaires détaillés, les attributs ou la description. Google interprète une fiche incomplète comme un signal de faible pertinence et la relègue derrière les concurrents mieux renseignés. La différence entre une fiche complète à 100% et une fiche remplie à 60% peut représenter 3 à 5 positions dans le Local Pack.",
	},
	{
		title: 'Des informations incohérentes entre le site et la fiche',
		copy: 'Le NAP (Nom, Adresse, Téléphone) doit être strictement identique partout : sur votre site web, votre fiche Google, vos réseaux sociaux et chaque annuaire où vous apparaissez. "Dr. Khalid — Av. Hassan II, Casablanca" sur le site et "Docteur Khalid — Avenue Hassan 2, Casa" sur Google, ce sont deux entités différentes pour l\'algorithme. Cette incohérence fragmente votre autorité locale.',
	},
	{
		title: 'Ignorer les avis clients (ou pire, y répondre mal)',
		copy: "Ne pas répondre aux avis Google — positifs comme négatifs — envoie un signal d'inactivité. Pire encore : une réponse agressive ou défensive à un avis négatif détruit la confiance de tous les prospects qui liront l'échange. La bonne pratique : répondre à chaque avis dans les 48 heures, remercier les positifs avec un détail personnalisé, traiter les négatifs avec professionnalisme et une proposition concrète de résolution.",
	},
	{
		title: 'Aucune photo ou des photos de mauvaise qualité',
		copy: "Selon Google, les fiches avec des photos reçoivent 42% de demandes d'itinéraire en plus et 35% de clics vers le site web en plus. Pourtant, la majorité des fiches de PME marocaines n'ont que la photo de couverture par défaut. Des photos professionnelles de votre local, de votre équipe et de vos réalisations sont un investissement minimal à impact maximal.",
	},
	{
		title: 'Un site web non optimisé pour mobile',
		copy: "Au Maroc, 85% du trafic web provient du mobile. Un site qui met plus de 3 secondes à charger sur un smartphone perd plus de la moitié de ses visiteurs avant même qu'ils voient votre contenu. Google intègre la vitesse mobile comme facteur de classement direct — un site lent pénalise aussi votre fiche Google Business dans les résultats locaux.",
	},
] as const;

const localSeoTimeline = [
	{
		step: '1',
		label: 'Semaines 1-2',
		title: 'Fondations techniques',
		desc: "Configuration de votre Google Business Profile optimisé, installation du tracking (Google Analytics + Search Console), audit technique de votre site. Votre fiche apparaît dans les résultats Google dès la validation — souvent en moins de 7 jours.",
	},
	{
		step: '2',
		label: 'Mois 1',
		title: 'Premiers signaux',
		desc: 'Vos premières impressions apparaissent dans Google Search Console. Votre fiche commence à remonter sur les requêtes de marque (votre nom + ville). Les citations locales (annuaires marocains, réseaux sociaux) commencent à renforcer votre cohérence NAP.',
	},
	{
		step: '3',
		label: 'Mois 2-3',
		title: 'Traction visible',
		desc: "Votre fiche Google Business gagne en visibilité sur les requêtes génériques de votre secteur. Les avis clients s'accumulent — chaque avis supplémentaire au-dessus de 4.5 étoiles renforce votre positionnement. Votre site apparaît dans les résultats organiques sur les requêtes longue traîne liées à vos services spécifiques.",
	},
	{
		step: '4',
		label: 'Mois 4-6',
		title: 'Résultats mesurables',
		desc: 'Votre fiche se stabilise dans le top 5 du Local Pack sur vos requêtes principales. Le trafic organique vers votre site augmente régulièrement. Les leads qualifiés (appels, WhatsApp, demandes de rendez-vous) deviennent un flux prévisible.',
		active: true,
	},
] as const;

const localSeoFaqs = [
	{
		question: "Qu'est-ce que le SEO local et pourquoi est-ce important pour mon entreprise au Maroc ?",
		answer: "Le référencement local est l'ensemble des techniques qui permettent à votre entreprise d'apparaître dans les résultats de recherche géolocalisés de Google — notamment dans le Local Pack (les 3 fiches avec carte) et sur Google Maps. Au Maroc, 80% des consommateurs recherchent un commerce ou un professionnel sur Google avant de se déplacer. Sans optimisation locale, votre entreprise est invisible pour ces clients potentiels, même s'ils se trouvent à 200 mètres de votre local.",
	},
	{
		question: 'Quelle est la différence entre le SEO classique et le SEO local ?',
		answer: 'Le SEO classique vise à positionner votre site web dans les résultats organiques de Google sur des requêtes nationales ou thématiques. Le SEO local cible spécifiquement les requêtes géolocalisées ("médecin Casablanca", "restaurant Marrakech") et optimise votre présence sur Google Maps et dans le Local Pack. Pour une entreprise qui sert des clients dans une zone géographique définie, le SEO local génère un retour sur investissement plus rapide et plus direct que le SEO national.',
	},
	{
		question: 'Combien coûte une prestation de SEO local au Maroc ?',
