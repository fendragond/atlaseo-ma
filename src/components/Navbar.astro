---
import { NAV_LINKS } from '../data/site';
import MilledButton from './MilledButton.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
	const normalized = href === '/' ? '/' : href.replace(/\/$/, '');
	return currentPath === normalized;
}
---

<header class="fixed inset-x-0 top-0 z-40">
	<div class="container-site py-sm">
		<nav
			class="glass-card flex items-center justify-between gap-md rounded-xl px-md py-sm"
			aria-label="Navigation principale"
		>
			<a href="/" aria-label="ATLASEO — retour à l'accueil">
				<img
					src="/images/logos/atlaseo-logo-horizontal.png"
					alt="ATLASEO Digital Agency"
					class="h-10 w-auto"
					width="368"
					height="67"
					loading="eager"
				/>
			</a>

			<ul class="hidden items-center gap-lg lg:flex">
				{
					NAV_LINKS.map(({ href, label }) => (
						<li>
							<a
								href={href}
								class:list={[
									"label-caps font-['Hanken_Grotesk'] font-bold transition-colors duration-200",
									isActive(href)
										? 'text-secondary'
										: 'text-on-surface-variant hover:text-on-surface',
								]}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="hidden lg:block">
				<MilledButton href="/contact" text="Obtenir un devis" size="sm" />
			</div>

			<button
				type="button"
				class="flex min-h-11 min-w-11 items-center justify-center rounded border border-outline-variant/50 lg:hidden"
				aria-expanded="false"
				aria-controls="mobile-nav"
				id="nav-toggle"
			>
				<span class="material-symbols-outlined" id="nav-toggle-icon">menu</span>
				<span class="sr-only">Ouvrir le menu</span>
			</button>
		</nav>

		<div
			id="mobile-nav"
			class="glass-card mt-sm hidden flex-col gap-sm rounded-xl p-md lg:hidden"
			hidden
		>
			<ul class="flex flex-col gap-sm">
				{
					NAV_LINKS.map(({ href, label }) => (
						<li>
							<a
								href={href}
								class:list={[
									"label-caps flex min-h-11 items-center font-['Hanken_Grotesk'] font-bold",
									isActive(href) ? 'text-secondary' : 'text-on-surface-variant',
								]}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
			<MilledButton href="/contact" text="Obtenir un devis" size="sm" class="w-full justify-center" />
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('mobile-nav');
	const icon = document.getElementById('nav-toggle-icon');

	toggle?.addEventListener('click', () => {
		const isOpen = menu?.hasAttribute('hidden') === false;
		if (isOpen) {
			menu?.setAttribute('hidden', '');
			toggle?.setAttribute('aria-expanded', 'false');
			if (icon) icon.textContent = 'menu';
		} else {
			menu?.removeAttribute('hidden');
			menu?.classList.remove('hidden');
			toggle?.setAttribute('aria-expanded', 'true');
			if (icon) icon.textContent = 'close';
		}
	});
</script>
