---
interface Props {
	href: string;
	text: string;
	icon?: string;
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { href, text, icon, size = 'md', class: className = '' } = Astro.props;

const sizeClasses = {
	sm: 'px-4 py-2',
	md: 'px-6 py-3',
	lg: 'px-8 py-4',
};
---

<a href={href} class:list={['milled-button', sizeClasses[size], className]}>
	{text}
	{icon && <span class="material-symbols-outlined text-lg">{icon}</span>}
</a>
