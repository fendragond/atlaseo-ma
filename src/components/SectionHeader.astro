---
interface Props {
	label?: string;
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
	inverted?: boolean;
	labelClass?: string;
}

const { label, title, subtitle, align = 'center', inverted = false, labelClass } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<header
	data-animate
	class:list={['flex flex-col gap-md max-w-3xl', alignClass, align === 'center' && 'mx-auto']}
>
	{label && (
		<p class:list={['label-caps text-secondary', labelClass]}>{label}</p>
	)}
	<h2
		class:list={[
			'font-display text-headline-lg-mobile font-semibold md:text-headline-lg',
			inverted ? 'text-on-primary' : 'text-on-surface',
		]}
	>
		{title}
	</h2>
	{subtitle && (
		<p class:list={['text-body-lg', inverted ? 'text-on-primary/80' : 'text-on-surface-variant']}>
			{subtitle}
		</p>
	)}
</header>
