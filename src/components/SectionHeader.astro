---
interface Props {
	label?: string;
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
}

const { label, title, subtitle, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<header
	data-animate
	class:list={['flex flex-col gap-md max-w-3xl', alignClass, align === 'center' && 'mx-auto']}
>
	{label && (
		<p class="label-caps text-secondary">{label}</p>
	)}
	<h2 class="font-display text-headline-lg-mobile font-semibold text-on-surface md:text-headline-lg">
		{title}
	</h2>
	{subtitle && (
		<p class="text-body-lg text-on-surface-variant">{subtitle}</p>
	)}
</header>
